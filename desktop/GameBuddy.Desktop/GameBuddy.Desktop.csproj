<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- The tray is a platform shell surface: the product's own presence on the player's desktop
         (design 103 section 6.1 / task 4). Windows Forms' NotifyIcon is the mature, supported
         implementation of one tray icon and its menu; nothing else in this project may use it. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>GameBuddy.Desktop</AssemblyName>
    <RootNamespace>GameBuddy.Desktop</RootNamespace>
  </PropertyGroup>
  <!--
    A Release build of the launcher carries its own runtime.

    The defect this closes: a framework-dependent build starts with the platform's "you need
    .NET 8.0 Desktop Runtime" dialog on any machine that has not installed it - before a single
    line of this product runs, so the player sees a Microsoft installer prompt for a runtime
    they were never told about and the product looks broken. Nothing about the launcher needs
    the machine's shared runtime, so Release is published self-contained, for one runtime
    identifier, as one file.

    It is scoped to Release on purpose: the test project and the developer's debug loop build
    framework-dependently against the SDK that is already present.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- The single-file host reads its own directory, and every native library the launcher
         needs (WPF's included) has to live inside the one file: with extraction disabled the
         publish left six native DLLs beside the exe, which is not the "double-click one file"
         the player downloads. Measured on win-x64: enabling it leaves exactly
         GameBuddy.Desktop.exe (+ .pdb) in the publish output. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="GameBuddy.Desktop.Tests" />
  </ItemGroup>
  <!-- Enabling Windows Forms adds its two namespaces to every implicit-using set, which made the
       existing code ambiguous with its own platform names (Timer, Application, ...). The shell is
       one file with its own explicit usings, so the namespaces stay out of everyone else's scope:
       WinForms belongs to the tray and to nothing else in this project. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
</Project>
