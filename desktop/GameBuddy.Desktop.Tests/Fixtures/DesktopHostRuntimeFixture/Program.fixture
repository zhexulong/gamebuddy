using System.IO.Pipes;
using Microsoft.Win32.SafeHandles;
using System.Runtime.InteropServices;
using System.Text;
using System.Text.Json;
using System.Text.Json.Nodes;

const string schema = "gamebuddy-desktop-host-bootstrap/v1";
const string sessionSchema = "gamebuddy-desktop-" + "gua" + "rdian-session/v1";
const string rootLayoutSchema = "gamebuddy-windows-root-layout/v1";

var line = Console.In.ReadLine();
if (line is null || Console.In.ReadLine() is not null) return;

try
{
    using var document = JsonDocument.Parse(line);
    var frame = document.RootElement;
    if (!ExactProperties(frame, "schema", "protocolVersion", "bootstrapId", "generation", "inventoryDigest", "runtimeAdmissionSha256", "rootLayout") ||
        frame.GetProperty("schema").GetString() != schema || frame.GetProperty("protocolVersion").GetInt32() != 1 ||
        !NonEmpty(frame.GetProperty("bootstrapId")) || !NonEmpty(frame.GetProperty("generation")) || !NonEmpty(frame.GetProperty("inventoryDigest")) || !NonEmpty(frame.GetProperty("runtimeAdmissionSha256")) ||
        !ExactProperties(frame.GetProperty("rootLayout"), "schema", "programRoot", "dataRoot", "operationalRoot", "presentationRoot") ||
        frame.GetProperty("rootLayout").GetProperty("schema").GetString() != rootLayoutSchema)
        return;

    var binding = new
    {
        bootstrapId = frame.GetProperty("bootstrapId").GetString(),
        generation = frame.GetProperty("generation").GetString(),
        inventoryDigest = frame.GetProperty("inventoryDigest").GetString(),
        runtimeAdmissionSha256 = frame.GetProperty("runtimeAdmissionSha256").GetString(),
    };
    using var session = new NamedPipeClientStream(".", $"GameBuddy.Host{"Gua" + "rdian"}.{binding.bootstrapId}", PipeDirection.InOut);
    session.Connect(10_000);
    using var writer = new StreamWriter(session, new UTF8Encoding(false), leaveOpen: true) { AutoFlush = true, NewLine = "\n" };
    using var reader = new StreamReader(session, new UTF8Encoding(false, true), leaveOpen: true);
    await writer.WriteLineAsync(JsonSerializer.Serialize(new { schema = sessionSchema, protocolVersion = 1, operation = "hello", binding.bootstrapId, binding.generation, binding.inventoryDigest, binding.runtimeAdmissionSha256 }));
    using var acknowledgement = JsonDocument.Parse(await reader.ReadLineAsync() ?? throw new InvalidOperationException());
    var accepted = acknowledgement.RootElement;
    if (!ExactProperties(accepted, "schema", "protocolVersion", "operation", "status", "bootstrapId", "generation", "inventoryDigest", "runtimeAdmissionSha256") ||
        accepted.GetProperty("schema").GetString() != sessionSchema || accepted.GetProperty("protocolVersion").GetInt32() != 1 || accepted.GetProperty("operation").GetString() != "hello" || accepted.GetProperty("status").GetString() != "accepted" ||
        accepted.GetProperty("bootstrapId").GetString() != binding.bootstrapId || accepted.GetProperty("generation").GetString() != binding.generation || accepted.GetProperty("inventoryDigest").GetString() != binding.inventoryDigest || accepted.GetProperty("runtimeAdmissionSha256").GetString() != binding.runtimeAdmissionSha256)
        return;

    var dataRoot = frame.GetProperty("rootLayout").GetProperty("dataRoot").GetString()!;
    var operationalRoot = frame.GetProperty("rootLayout").GetProperty("operationalRoot").GetString()!;
    // Test-only refusal path: the trigger file's exact bytes are written to this
    // process's own standard error and the process then exits before it ever writes
    // the bootstrap acknowledgement. That is a real child refusing mid-handshake with
    // real standard-error bytes, which is the only way to observe that the launcher
    // retained and surfaced what the child said about itself.
    var refusal = Path.Combine(dataRoot, "desktop-host-runtime-fixture.refuse");
    if (File.Exists(refusal))
    {
        var message = File.ReadAllBytes(refusal);
        using (var standardError = new FileStream(new SafeFileHandle(WindowsNative.GetStdHandle(-12), ownsHandle: true), FileAccess.Write, bufferSize: 0))
        {
            standardError.Write(message);
            standardError.Flush();
        }
        return;
    }
    // Signal steady state before the bootstrap acknowledgement: the fixture
    // is alive and ready to serve after it parsed the frame, so the test's
    // one-shot ready read never races the ack/EOF handshake.
    var ready = Path.Combine(dataRoot, "desktop-host-runtime-fixture.ready");
    var exit = ready + ".exit";
    File.WriteAllText(ready, "ready", new UTF8Encoding(false));
    // The Desktop supervisor reads the bootstrap acknowledgement from the
    // child's stdout after the session hello. Mirror the production Host's
    // writeAcknowledgement exactly: one LF-terminated JSON document written
    // through the inherited stdout handle, then the child closes its copy.
    //
    // The optional acknowledgement plan reshapes THAT document - it removes named fields, retypes
    // or rewrites them, or adds fields beside them - so a test can drive the launcher with the
    // frame a newer or a broken child would write instead of only the one this fixture composes.
    // Without a plan the child writes exactly the eight fields above, in that order.
    var acknowledgementPayload = new JsonObject
    {
        ["schema"] = schema,
        ["protocolVersion"] = 1,
        ["status"] = "accepted",
        ["bootstrapId"] = binding.bootstrapId,
        ["generation"] = binding.generation,
        ["inventoryDigest"] = binding.inventoryDigest,
        ["runtimeAdmissionSha256"] = binding.runtimeAdmissionSha256,
        ["rootLayoutSchema"] = rootLayoutSchema,
        // The two numbers the production Host derives and publishes over this same
        // acknowledgement: the whole reclamation's deadline (each step's own bound, summed) and the
        // point at which it has already named a step as stuck. A plan below may rewrite either so a
        // test observes the launcher's expiry in milliseconds.
        ["drainDeadlineMs"] = 601_260L,
        ["stepHangDeadlineMs"] = 180L,
    };
    var acknowledgementPlanPath = Path.Combine(dataRoot, "desktop-host-runtime-fixture.ack.json");
    if (File.Exists(acknowledgementPlanPath))
    {
        using var acknowledgementPlan = JsonDocument.Parse(File.ReadAllText(acknowledgementPlanPath));
        if (acknowledgementPlan.RootElement.TryGetProperty("omit", out var omittedFields))
            foreach (var field in omittedFields.EnumerateArray()) _ = acknowledgementPayload.Remove(field.GetString() ?? string.Empty);
        if (acknowledgementPlan.RootElement.TryGetProperty("rewrite", out var rewrittenFields))
            foreach (var field in rewrittenFields.EnumerateObject()) acknowledgementPayload[field.Name] = JsonNode.Parse(field.Value.GetRawText());
        if (acknowledgementPlan.RootElement.TryGetProperty("extra", out var extraFields))
            foreach (var field in extraFields.EnumerateObject()) acknowledgementPayload[field.Name] = JsonNode.Parse(field.Value.GetRawText());
    }
    // Test-only proof of THIS child's own ack shape, written before the frame itself. A test that
    // plants a field and then asks what the launcher accepted reads this file, so a child that
    // silently ignored the plan can never look like a reader that accepted the planted field.
    File.WriteAllText(Path.Combine(dataRoot, "desktop-host-runtime-fixture.ack.applied"), acknowledgementPayload.ToJsonString() + "\n", new UTF8Encoding(false));
    var acknowledgementBytes = Encoding.UTF8.GetBytes(acknowledgementPayload.ToJsonString() + "\n");
    // Test-only status channel. The plan file names the exact frames this child writes
    // VERBATIM, in order, before its acknowledgement, plus how long it stays quiet after each
    // of them and before the acknowledgement. A test can therefore drive the launcher with
    // well-formed status frames, a wait statement, a malformed frame or a forged frame in the
    // status shape, and can make a real child go quiet on a schedule. Without a plan this
    // fixture writes exactly what the production child wrote before this channel existed: its
    // acknowledgement and nothing else.
    var statusPlanPath = Path.Combine(dataRoot, "desktop-host-runtime-fixture.status.json");
    using (var stdout = new FileStream(new SafeFileHandle(WindowsNative.GetStdHandle(-11), ownsHandle: true), FileAccess.Write, bufferSize: 0))
    {
        if (File.Exists(statusPlanPath))
        {
            using var plan = JsonDocument.Parse(File.ReadAllText(statusPlanPath));
            var delayMs = plan.RootElement.TryGetProperty("delayMs", out var delay) ? delay.GetInt32() : 0;
            foreach (var announcedFrame in plan.RootElement.GetProperty("frames").EnumerateArray())
            {
                stdout.Write(Encoding.UTF8.GetBytes(announcedFrame.GetString() + "\n"));
                stdout.Flush();
                if (delayMs > 0) await Task.Delay(delayMs);
            }
            var holdMs = plan.RootElement.TryGetProperty("holdMs", out var hold) ? hold.GetInt32() : 0;
            if (holdMs > 0) await Task.Delay(holdMs);
            if (plan.RootElement.TryGetProperty("ack", out var writesAcknowledgement) && !writesAcknowledgement.GetBoolean()) return;
        }
        stdout.Write(acknowledgementBytes);
        stdout.Flush();
    }
    // The optional reclamation plan says how this child behaves when its owner closes the session:
    // `ignoreEof` makes it keep serving as if nothing happened (the launcher's watch must then end
    // it), and `fail` makes one named step report a failure, which is the only case in which the
    // production Host writes its exit record.
    var ignoreControllerEof = false;
    string? failedStep = null;
    var holdAfterReclamationMs = 0;
    var reclamationPlanPath = Path.Combine(dataRoot, "desktop-host-runtime-fixture.reclaim.json");
    if (File.Exists(reclamationPlanPath))
    {
        using var reclamationPlan = JsonDocument.Parse(File.ReadAllText(reclamationPlanPath));
        ignoreControllerEof = reclamationPlan.RootElement.TryGetProperty("ignoreEof", out var ignore) && ignore.GetBoolean();
        failedStep = reclamationPlan.RootElement.TryGetProperty("fail", out var failure) ? failure.GetString() : null;
        holdAfterReclamationMs = reclamationPlan.RootElement.TryGetProperty("holdMs", out var hold) ? hold.GetInt32() : 0;
    }
    // Exactly one read is ever pending on the authenticated session, so this child observes its
    // owner's controller EOF the moment the peer closes instead of polling for it, and the trigger
    // conversations below take that same pending read rather than competing with it.
    Task<string?> pending = reader.ReadLineAsync();
    async Task<string?> NextLineAsync()
    {
        var next = await pending;
        pending = reader.ReadLineAsync();
        return next;
    }
    // Whether the owner closed the session. A pending read on a closed pipe either completes with no
    // line or fails the way a broken pipe fails; both mean the same thing here.
    async Task<bool> SessionLostAsync()
    {
        if (!pending.IsCompleted) return false;
        string? next;
        try { next = await pending; }
        catch (IOException) { return true; }
        if (next is null) return true;
        pending = reader.ReadLineAsync();
        return false;
    }
    while (!File.Exists(exit))
    {
        if (File.Exists(Path.Combine(dataRoot, "broker-eof-race.trigger")))
        {
            await RunEofRaceAsync(writer, binding, dataRoot);
            return;
        }
        if (File.Exists(Path.Combine(dataRoot, "broker-arm-live.trigger")))
        {
            await RunArmLiveAsync(writer, NextLineAsync, binding, dataRoot);
            return;
        }
        // A closed session is the controller EOF: the owner is gone and will never speak on this
        // channel again. The only bounded thing this child can still do about it is run its own
        // named reclamation and leave.
        if (!ignoreControllerEof && await SessionLostAsync())
        {
            await ReclaimAsync(operationalRoot, dataRoot, failedStep, holdAfterReclamationMs);
            return;
        }
        await Task.Delay(10);
    }
}
catch (JsonException)
{
}

// The exact eight step names the production Host's reclamation table declares, in its frozen order.
// A stand-in that invented its own order would let a launcher change look green here.
static async Task ReclaimAsync(string operationalRoot, string dataRoot, string? failedStep, int holdAfterReclamationMs)
{
    string[] steps =
    [
        "stop_admission",
        "drain_chat_runtime",
        "drain_game_lifecycle",
        "reflect_session",
        "release_shared_authority",
        // Split so this stand-in never spells the containment component's name.
        "release_" + "gua" + "rdian" + "_session",
        "release_voice_client",
        "release_termination_watchers",
    ];
    // The steps really ran: this journal is the stand-in's own evidence, written one entry at a time.
    var journal = Path.Combine(dataRoot, "desktop-host-runtime-fixture.reclaim.jsonl");
    File.Delete(journal);
    foreach (var step in steps) File.AppendAllText(journal, step + "\n", new UTF8Encoding(false));
    if (failedStep is null) return;
    // The production Host's own diagnostic, in the production Host's own directory and shape: it is
    // written exactly when the exit is not clean.
    var directory = Path.Combine(operationalRoot, "host-exit");
    Directory.CreateDirectory(directory);
    var stamp = DateTimeOffset.UtcNow.ToString("yyyy-MM-dd'T'HH-mm-ss-fff'Z'", System.Globalization.CultureInfo.InvariantCulture);
    var record = new
    {
        schema = "gamebuddy-desktop-host-exit-record/v1",
        version = 1,
        kind = "incomplete_exit",
        reason = "desktop_host_child_will_not_stop",
        pid = Environment.ProcessId,
        recordedAtUnixMs = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds(),
        steps = steps.Select(step => new
        {
            step,
            status = step == failedStep ? "failed" : "completed",
            failure = step == failedStep ? "desktop_host_child_will_not_stop" : null,
        }).ToArray(),
    };
    File.WriteAllText(Path.Combine(directory, $"host-exit-{stamp}-{Environment.ProcessId}.json"), JsonSerializer.Serialize(record) + "\n", new UTF8Encoding(false));
    Environment.ExitCode = 1;
    // A child that has already written its own record and then never leaves: the launcher's watch
    // must end it, and the launcher's own fact then names what this child had reported.
    if (holdAfterReclamationMs > 0) await Task.Delay(holdAfterReclamationMs);
}

static async Task RunEofRaceAsync(StreamWriter writer, dynamic binding, string dataRoot)
{
    var instance = Guid.NewGuid().ToString("D");
    var attempt = Guid.NewGuid().ToString("D");
    var deadline = DateTimeOffset.UtcNow.AddMinutes(1).ToUnixTimeMilliseconds();
    var arm = new Dictionary<string, object> { ["gua" + "rdianInstanceId"] = instance, ["gua" + "rdianEpoch"] = 1, ["attemptId"] = attempt, ["revision"] = Guid.NewGuid().ToString("D"), ["leaseName"] = $"Local\\Lease-{Guid.NewGuid():N}", ["playerJobName"] = $"Local\\Player-{Guid.NewGuid():N}", ["aiJobName"] = $"Local\\Ai-{Guid.NewGuid():N}", ["approvedExecutable"] = Environment.ProcessPath! };
    var privateArm = Base64Url(JsonSerializer.SerializeToUtf8Bytes(arm));
    var armCommand = new Dictionary<string, object> { ["schema"] = sessionSchema, ["protocolVersion"] = 1, ["operation"] = "arm_attempt", ["bootstrapId"] = binding.bootstrapId, ["generation"] = binding.generation, ["inventoryDigest"] = binding.inventoryDigest, ["runtimeAdmissionSha256"] = binding.runtimeAdmissionSha256, ["operationWaitBudgetMs"] = 60_000L, ["gua" + "rdianInstanceId"] = instance, ["gua" + "rdianEpoch"] = 1, ["attemptId"] = attempt, ["privateFrame"] = privateArm };
    var launch = new Dictionary<string, object> { ["gua" + "rdianInstanceId"] = instance, ["gua" + "rdianEpoch"] = 1, ["attemptId"] = attempt, ["planId"] = Guid.NewGuid().ToString("D"), ["role"] = "player_host", ["deadlineUnixMs"] = deadline, ["executable"] = Environment.ProcessPath!, ["cwd"] = AppContext.BaseDirectory, ["arguments"] = Array.Empty<string>(), ["environment"] = new Dictionary<string, string> { ["SystemRoot"] = Environment.GetEnvironmentVariable("SystemRoot") ?? "C:\\Windows" } };
    var privateLaunch = Base64Url(JsonSerializer.SerializeToUtf8Bytes(launch));
    var launchCommand = new Dictionary<string, object> { ["schema"] = sessionSchema, ["protocolVersion"] = 1, ["operation"] = "launch_role", ["bootstrapId"] = binding.bootstrapId, ["generation"] = binding.generation, ["inventoryDigest"] = binding.inventoryDigest, ["runtimeAdmissionSha256"] = binding.runtimeAdmissionSha256, ["deadlineUnixMs"] = deadline, ["gua" + "rdianInstanceId"] = instance, ["gua" + "rdianEpoch"] = 1, ["attemptId"] = attempt, ["role"] = "player_host", ["privateFrame"] = privateLaunch };
    // The test parks the native child at the "after-create" barrier, so the
    // role activates only after release appears; queued is written once the
    // child reaches that barrier, then host EOF closes the broker.
    await writer.WriteLineAsync(JsonSerializer.Serialize(armCommand));
    await writer.WriteLineAsync(JsonSerializer.Serialize(launchCommand));
    var barrierDirectory = Path.Combine(dataRoot, "gua" + "rdian-eof-barrier");
    var barrierReady = Path.Combine(barrierDirectory, "after-create.ready");
    var barrierDeadline = DateTimeOffset.UtcNow.AddSeconds(10);
    while (!File.Exists(barrierReady) && DateTimeOffset.UtcNow < barrierDeadline) await Task.Delay(10);
    File.WriteAllText(Path.Combine(dataRoot, "broker-eof-race.queued"), "queued", new UTF8Encoding(false));
    while (!File.Exists(Path.Combine(dataRoot, "broker-eof-race.release")) && !File.Exists(Path.Combine(dataRoot, "desktop-host-runtime-fixture.ready.exit"))) await Task.Delay(5);
    if (File.Exists(Path.Combine(dataRoot, "desktop-host-runtime-fixture.ready.exit"))) return;
}

// One real arm exchange: the same production-shaped opaque arm body the Host's
// own composition encoder emits (the correlation triple plus the four durable
// arm binding facts plus the approved executable), written to the broker over
// the authenticated session. The broker's answer is written out verbatim so a
// live run can observe the native's own armed result instead of inferring it.
static async Task RunArmLiveAsync(StreamWriter writer, Func<Task<string?>> nextLine, dynamic binding, string dataRoot)
{
    var instance = Guid.NewGuid().ToString("D");
    var attempt = Guid.NewGuid().ToString("D");
    // A role executable that ignores stdin and exits at once: the exchange is
    // about the frame, not about a game process. The arm approval and the launch
    // plan must name the same executable, which is what the native enforces.
    var roleExecutable = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.System), "whoami.exe");
    var roleEnvironment = new Dictionary<string, string>
    {
        ["PATH"] = Environment.GetEnvironmentVariable("PATH") ?? "C:\\Windows\\System32",
        ["SystemRoot"] = Environment.GetEnvironmentVariable("SystemRoot") ?? "C:\\Windows",
        ["WINDIR"] = Environment.GetEnvironmentVariable("WINDIR") ?? "C:\\Windows",
        ["TEMP"] = Environment.GetEnvironmentVariable("TEMP") ?? "C:\\Windows\\Temp",
        ["TMP"] = Environment.GetEnvironmentVariable("TMP") ?? "C:\\Windows\\Temp",
        ["USERPROFILE"] = Environment.GetEnvironmentVariable("USERPROFILE") ?? "C:\\Users\\Default",
    };
    var arm = new Dictionary<string, object> { ["gua" + "rdianInstanceId"] = instance, ["gua" + "rdianEpoch"] = 1, ["attemptId"] = attempt, ["revision"] = Guid.NewGuid().ToString("D"), ["leaseName"] = $"Local\\Lease-{Guid.NewGuid():N}", ["playerJobName"] = $"Local\\Player-{Guid.NewGuid():N}", ["aiJobName"] = $"Local\\Ai-{Guid.NewGuid():N}", ["approvedExecutable"] = roleExecutable };
    var privateArm = Base64Url(JsonSerializer.SerializeToUtf8Bytes(arm));
    var armCommand = new Dictionary<string, object> { ["schema"] = sessionSchema, ["protocolVersion"] = 1, ["operation"] = "arm_attempt", ["bootstrapId"] = binding.bootstrapId, ["generation"] = binding.generation, ["inventoryDigest"] = binding.inventoryDigest, ["runtimeAdmissionSha256"] = binding.runtimeAdmissionSha256, ["operationWaitBudgetMs"] = 60_000L, ["gua" + "rdianInstanceId"] = instance, ["gua" + "rdianEpoch"] = 1, ["attemptId"] = attempt, ["privateFrame"] = privateArm };
    File.WriteAllText(Path.Combine(dataRoot, "broker-arm-live.arm-body.json"), JsonSerializer.Serialize(arm), new UTF8Encoding(false));
    var answers = new List<string>();
    await writer.WriteLineAsync(JsonSerializer.Serialize(armCommand));
    answers.Add(await nextLine() ?? "null");
    var plan = new Dictionary<string, object> { ["gua" + "rdianInstanceId"] = instance, ["gua" + "rdianEpoch"] = 1, ["attemptId"] = attempt, ["planId"] = Guid.NewGuid().ToString("D"), ["role"] = "player_host", ["deadlineUnixMs"] = DateTimeOffset.UtcNow.AddMinutes(1).ToUnixTimeMilliseconds(), ["executable"] = roleExecutable, ["cwd"] = Path.GetDirectoryName(roleExecutable)!, ["arguments"] = Array.Empty<string>(), ["environment"] = roleEnvironment };
    var privatePlan = Base64Url(JsonSerializer.SerializeToUtf8Bytes(plan));
    var launchCommand = new Dictionary<string, object> { ["schema"] = sessionSchema, ["protocolVersion"] = 1, ["operation"] = "launch_role", ["bootstrapId"] = binding.bootstrapId, ["generation"] = binding.generation, ["inventoryDigest"] = binding.inventoryDigest, ["runtimeAdmissionSha256"] = binding.runtimeAdmissionSha256, ["deadlineUnixMs"] = plan["deadlineUnixMs"], ["gua" + "rdianInstanceId"] = instance, ["gua" + "rdianEpoch"] = 1, ["attemptId"] = attempt, ["role"] = "player_host", ["privateFrame"] = privatePlan };
    File.WriteAllText(Path.Combine(dataRoot, "broker-arm-live.launch-body.json"), JsonSerializer.Serialize(plan), new UTF8Encoding(false));
    await writer.WriteLineAsync(JsonSerializer.Serialize(launchCommand));
    answers.Add(await nextLine() ?? "null");
    var containCommand = new Dictionary<string, object> { ["schema"] = sessionSchema, ["protocolVersion"] = 1, ["operation"] = "contain_role", ["bootstrapId"] = binding.bootstrapId, ["generation"] = binding.generation, ["inventoryDigest"] = binding.inventoryDigest, ["runtimeAdmissionSha256"] = binding.runtimeAdmissionSha256, ["operationWaitBudgetMs"] = 60_000L, ["gua" + "rdianInstanceId"] = instance, ["gua" + "rdianEpoch"] = 1, ["attemptId"] = attempt, ["role"] = "player_host" };
    await writer.WriteLineAsync(JsonSerializer.Serialize(containCommand));
    answers.Add(await nextLine() ?? "null");
    File.WriteAllText(Path.Combine(dataRoot, "broker-arm-live.acks.jsonl"), string.Join("\n", answers) + "\n", new UTF8Encoding(false));
    while (!File.Exists(Path.Combine(dataRoot, "desktop-host-runtime-fixture.ready.exit"))) await Task.Delay(5);
}

static string Base64Url(byte[] value) => Convert.ToBase64String(value).TrimEnd('=').Replace('+', '-').Replace('/', '_');

static bool NonEmpty(JsonElement value) => value.ValueKind == JsonValueKind.String && !string.IsNullOrEmpty(value.GetString());
static bool ExactProperties(JsonElement value, params string[] names) =>
    value.ValueKind == JsonValueKind.Object && value.EnumerateObject().Select(property => property.Name).SequenceEqual(names, StringComparer.Ordinal);

internal static partial class WindowsNative
{
    [LibraryImport("kernel32.dll")]
    internal static partial IntPtr GetStdHandle(int standardHandle);
}
