      ],
      "project": [
        "src/**/*.mjs",
        "tests/**/*.mjs",
        "scenarios/**/*.mjs"
      ],
      "ignoreDependencies": [
        // Both packages are reached only from `src/analysis/**`, and neither through a form an
        // import graph can follow on its own: `web-tree-sitter` is a namespace import there,
        // while the grammar is a `.wasm` FILE resolved by path (`require.resolve`). Dev mode
        // reaches one of them through the test entries and reports this list as redundant;
        // `--production` drops those entries and then reports both as unused dependencies.
        // Measured 2026-11-06: without this list `pnpm knip:production` exits 1 naming exactly
        // these two, so the list is the one place both passes agree.
        "@vscode/tree-sitter-wasm",
        "web-tree-sitter"
      ]
    }
  },
  // No `ignore` list: each row it held named a worker, a fixture directory or a devkit CLI that the
  // entry model now covers (the four spawned workers are `host` entries, the memory manifests are a
  // pattern the test scans). `integrations/stardew/action-development/src/devkit-local/**` and
  // `tools/.tmp-*` were dropped rather than narrowed: the first hid two files nothing imports
  // (`game-action-cli.mjs`, whose `pnpm exec game-action` scripts name a bin no package declares, and
  // the `index.mjs` barrel), which are reported as unused files now, and the second matched no file at
  // all.
  "ignoreBinaries": [
    "playwright",
    "pwsh",
    "where.exe",
    "taskkill.exe",
    "game-action",
    "reg"
  ]
}
