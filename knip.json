        "tools/run-stardew-native-local-player-clear-debris-probe.mjs",
        "tools/run-stardew-native-local-stop-deadline-probe.mjs",

        // Named by a gate that judges the file, or the generator of an artifact a gate compares byte for byte.
        "tools/check-live-run-closures.mjs", // gates/meta/prelive-register-tables.mjs:94
        "tools/generate-vocabulary.mjs", // VOCABULARY_GENERATOR, gates/data/check-generated-artifact-reproducibility.mjs:129
        "tools/harvest-stardew-receipts.mjs", // producer of host/src/test-fixtures/stardew-receipts/corpus.json, named by host/src/stardew-receipt-corpus.ts:5
        "tools/lib/source-citation.mjs", // imported by gates/stardew/check-stardew-source-citations.mjs:87
        "tools/lib/stardew-actor-holds.mjs", // imported by gates/stardew/check-stardew-actor-admissibility.mjs:80
        "tools/live-run/game/capability-audit.mjs", // read by tools/live-run/game/run-stardew-native-local-agent-ab-live.support.mjs:48
        "tools/live-run/game/stardew-world-survival-live.mjs", // silent-catch site row in tools/lib/silent-failure.mjs:691
        "tools/record-stardew-live-receipts.mjs", // regenerates host/src/test-fixtures/stardew-live-receipts.json, named by gates/stardew/check-stardew-action-promotion.mjs:48
        "tools/run-windows-sensevoice-final-transcript-gate.mjs", // read by tools/lib/voice-gateway-probe-client.test.mjs:54
        "tools/run-windows-voice-output-gate.mjs", // read by tools/lib/voice-gateway-probe-client.test.mjs:53
        "tools/lib/voice-final-gate-server.mjs", // spawned by tools/run-windows-sensevoice-final-transcript-gate.mjs:29

        // The memory live-loop's manifests: the test reads the directory, not a list of names
        // (tools/live-run/memory/run-memory-live-loop.test.mjs:16), so the pattern is the population.
        "tools/fixtures/chat-run-audit/memory-probes/*.manifest.mjs",

        // Declared by a register or a runbook as a gate or tool a person runs by hand.
        "tools/live-run/chat/check-post-history-instructions-live.mjs", // UNSCANNED_GATES, "typed by hand" (gates/meta/prelive-register-tables.mjs)
        "tools/live-run/analysis/long-session-metrics.mjs", // tools/live-run/analysis/README.md:28
        "tools/live-run/analysis/round3-verdict.mjs", // tools/live-run/analysis/README.md:25
        "tools/run-stardew-native-local-path-predicate-probe.mjs", // fixtures/stardew/RUNBOOK.md:1269
        "tools/sandbox/sandbox-bus.mjs", // tools/sandbox/FINDINGS.md:77
        "tools/verify-phase0b-host.mjs" // host/README.md:139
      ],
      "project": [
        "tools/**/*.mjs"
      ],
      "ignoreDependencies": [
        // @biomejs/biome is used, but through a path knip cannot follow. knip resolves a
        // dependency from a package.json script's binary token (`lint: "biome lint ..."`,
        // `format:check: "biome format ..."`) or from the import graph. Both formatter and
        // linter now go through tools/scripts/check-{format,lint}-ratchet.mjs, which spawn
        // node_modules/@biomejs/biome/bin/biome by absolute path; 76cb49da (2026-10-14)
        // turned the last of those two script tokens into a ratchet call, so the only
        // signal knip had disappeared while the dependency stayed load-bearing. Dropping
        // it would break both ratchets; this names the one dependency and why.
        "@biomejs/biome"
      ]
    },
    "packages/game-action-program": {
      "entry": [],
      "project": [
        "src/**/*.mjs",
        "tests/**/*.mjs"
      ]
    },
