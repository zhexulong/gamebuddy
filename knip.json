{
  "workspaces": {
    ".": {
      "entry": [
        // knip reads the file arguments of `package.json` scripts itself, so a tool a script runs needs no row
        // here; a tool a PowerShell or Python entry point runs does not have that path into the graph. The three
        // rows that used to stand here (`tools/*.mjs`, `tools/sandbox/*.mjs`, `tools/live-run/**/*.mjs`) covered
        // 115 files between them, and 34 of those are covered by no row below because nothing in this tree runs or
        // reads them: they are reported as unused files, which is the finding the governance doc asks for rather
        // than an entry asserting a reachability nothing backs (measured 2026-11-25, `.tmp/lane-governance.md`).
        //
        // Each row names the one consumer knip cannot follow. A row whose file disappears is an unmatched pattern,
        // which knip prints as a configuration hint, so the lists expire themselves; a new tool is uncovered until
        // a row names what runs it.

        // Two directory scans own their population, so the pattern mirrors the scan rather than guessing at it:
        // `RUNNER_FILE_PATTERN` (gates/stardew/check-stardew-live-runner-coverage.mjs:112, and the same shape in
        // gates/stardew/audit-stardew-native-local-runner-contract.mjs:202) and `benchFiles()`
        // (tools/perf/run-benchmarks.mjs:28 - `readdirSync(...).filter(name => name.endsWith(".bench.mjs"))`).
        "tools/run-stardew-native-local-player-*-smoke.mjs",
        "tools/perf/*.bench.mjs",

        // Spawned by a sibling by path rather than imported, or run against the file as its subject. A file whose
        // only consumer is a `spawn` is unreachable to an import-graph tool, and deleting it because knip called it
        // unused would remove a working gate. `report-run-cost.mjs` is run by `run-chat-live-audit.mjs` and imports
        // `run-cost-usage.mjs`; `check-lockfile-freeze.mjs` is spawned twice by `scripts/pre-commit.mjs`.
        "tools/lib/chat-run-audit.mjs!",
        "tools/lib/stardew-decompile-root.mjs!",
        "tools/lib/stardew-native-multiplayer-sensitivity.mjs!",
        "tools/lib/stardew-native-smoke-harness-v1.mjs!",
        "tools/lib/stardew-shared-world-navigation.mjs!",
        "tools/lib/tavern-mounted-operation-vocabulary.mjs!",
        "tools/lib/voice-gateway-launch.mjs!",
        "tools/live-run/frontend/phases/capture.mjs!",
        "tools/live-run/frontend/phases/launch.mjs!",
        "tools/live-run/frontend/phases/report.mjs!",
        "tools/live-run/frontend/probes/prerequisite-check.mjs!",
        "tools/live-run/frontend/probes/runtime-discover.mjs!",
        "tools/perf/report-run-cost.mjs!",
        "tools/scripts/check-lockfile-freeze.mjs!",
        // Each `//` names the spawner that builds the path.
        "tools/compare-live-run-findings.mjs", // tools/compare-live-run-findings.test.mjs:8
        "tools/live-run/analysis/airp-scorecard.mjs", // tools/live-run/analysis/airp-scorecard.test.mjs:22
        "tools/live-run/frontend/capture/reconciliation-verdict.mjs", // require()d by capture/{m-opening-picker,t-installation-discovery,u-preset-assembly}.cjs
        "tools/prepare-tavern-live-fixture.mjs", // tools/prepare-tavern-live-fixture.test.mjs:10
        "tools/run-live-chat-card-e2e.mjs", // tools/live-run/memory/run-memory-live-loop.mjs:261
        "tools/run-tavern-management-operation-evidence.mjs", // tools/run-tavern-management-operation-evidence.test.mjs:19
        "tools/score-stardew-companion-live-scenarios.mjs", // tools/stardew-companion-live-scorer.test.mjs:134

        // Spawned by a PowerShell entry point, which knip cannot read at all.
        "tools/apply-stardew-fixture-bridge-override.mjs", // tools/start-farmhand-launcher.ps1:478
        "tools/await-stardew-fixture-readiness.mjs", // tools/run-stardew-attachment-regression.ps1:161
        "tools/bootstrap-stardew-native-local-player-fixture.mjs", // tools/run-stardew-native-local-player-move-fixture.ps1:422
        "tools/capture-mimo-contract.mjs", // tools/capture-mimo-contract.ps1:11
        "tools/live-run/frontend/probes/verified-helper-pair.mjs", // tools/live-run/frontend/phases/pin.ps1:17
        "tools/prepare-stardew-fixture-profile.mjs", // tools/start-farmhand-launcher.ps1:432
        "tools/prepare-stardew-native-local-player-fixture.mjs", // tools/launch-stardew-navigation-fixture.ps1:59
        "tools/restore-stardew-fixture-profile.mjs", // tools/start-farmhand-launcher.ps1:726
        "tools/restore-stardew-native-local-player-fixture.mjs", // tools/lib/live-run-teardown.mjs (spawn), gates/data/check-live-run-isolation.mjs
        "tools/run-stardew-shared-world-action.mjs", // tools/run-stardew-shared-world-action.ps1:461
        "tools/stardew-attachment-request.mjs", // tools/run-stardew-attachment-regression.ps1:265
        "tools/stardew-shared-world-attachment-request.mjs", // tools/run-stardew-shared-world-action.ps1:379

        // Rows of `integrations/stardew/action-development/tool-inventory.json`, which enumerates the tools its
        // `governedPatterns` cover and fails when one is unregistered. These are read-only probes and smoke
        // harnesses: run by hand, never imported.
        "tools/replay-stardew-destination-search-operation.mjs",
        "tools/replay-stardew-world-map-operation.mjs",
        "tools/run-stardew-agent-context-reentry.mjs",
        "tools/run-stardew-agent-game-smoke.mjs",
        "tools/run-stardew-body-smoke.mjs",
