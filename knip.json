      // consumers - the same shape as `src/identity-profile.ts!` above, and narrower than making the files entry points.
      "ignoreIssues": {
        "src/game-surface-prompt-floor.ts": ["exports"]
      }
    },
    "dialogue-web": {
      "entry": [
        "src/main.tsx!",
        "src/components/ComposedReferenceGameApp.tsx!",
