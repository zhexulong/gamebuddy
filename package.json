{
  "name": "gamebuddy",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24.13.0 <25",
    "pnpm": ">=11.1.3 <12"
  },
  "scripts": {
    "build": "pnpm --filter @gamebuddy/companion-host build && pnpm --filter @gamebuddy/voice-gateway build",
    "test": "pnpm --filter @gamebuddy/companion-host test && pnpm --filter @gamebuddy/voice-gateway test",
    "typecheck": "pnpm --filter @gamebuddy/companion-host typecheck && pnpm --filter @gamebuddy/voice-gateway typecheck",
    "dependency-audit": "node tools/generate-sbom.mjs",
    "verify-demo-prerequisites": "node tools/verify-demo-prerequisites.mjs"
  }
}
