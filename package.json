{
  "name": "gamebuddy",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24.13.0 <25",
    "pnpm": ">=11.1.3 <12"
  },
  "scripts": {
    "build": "pnpm --filter @gamebuddy/voice-protocol build && pnpm --filter @gamebuddy/companion-host build && pnpm --filter @gamebuddy/voice-gateway build && pnpm --filter @gamebuddy/dialogue-web build",
    "test": "pnpm --filter @gamebuddy/voice-protocol test && pnpm --filter @gamebuddy/companion-host test && pnpm --filter @gamebuddy/voice-gateway test",
    "typecheck": "pnpm --filter @gamebuddy/voice-protocol typecheck && pnpm --filter @gamebuddy/companion-host typecheck && pnpm --filter @gamebuddy/voice-gateway typecheck",
    "dependency-audit": "node tools/generate-sbom.mjs",
    "verify-demo-prerequisites": "node tools/verify-demo-prerequisites.mjs",
    "check:stardew-action-surface": "node tools/check-stardew-action-promotion.mjs",
    "derive:stardew-native-action-architecture-map": "node tools/derive-stardew-native-action-architecture-map.mjs",
    "test:stardew-native-architecture-accounting": "node --test tools/stardew-native-architecture-accounting.test.mjs",
    "test:stardew-fixture-profile": "node --test tools/stardew-fixture-profile.test.mjs",
    "test:stardew-fixture-transaction-inspector": "node --test tools/stardew-fixture-transaction-inspector.test.mjs",
    "inspect:stardew-fixture-transaction": "node tools/inspect-stardew-fixture-transaction.mjs",
    "test:stardew-attachment-telemetry": "powershell.exe -NoProfile -File tools/stardew-attachment-telemetry.test.ps1",
    "test:stardew-fixture-readiness": "node tools/await-stardew-fixture-readiness.test.mjs",
    "test:stardew-formal-action-gate": "node --test tools/stardew-formal-action-gate.test.mjs",
    "test:stardew-gate-failure-taxonomy": "node --test tools/stardew-gate-failure-taxonomy.test.mjs",
    "test:stardew-action-gate-descriptors": "node --test tools/stardew-action-gate-descriptors.test.mjs",
    "test:stardew-portfolio-p1": "pnpm --filter @gamebuddy/companion-host exec tsc --project tsconfig.portfolio.json && pnpm --filter @gamebuddy/companion-host exec node --test dist-portfolio/portfolio-protocol.test.js dist-portfolio/portfolio-stardew-bridge.test.js",
    "test:stardew-csharp-syntax-structural-canary": "node --test tools/stardew-csharp-syntax-structural-canary.test.mjs",
    "derive:stardew-csharp-syntax-structural-canary": "node tools/derive-stardew-csharp-syntax-structural-canary.mjs",
    "build:voice-protocol": "pnpm --filter @gamebuddy/voice-protocol build",
    "typecheck:voice-protocol": "pnpm --filter @gamebuddy/voice-protocol typecheck",
    "test:voice-protocol": "pnpm --filter @gamebuddy/voice-protocol test"
  },
  "workspaces": [
    "packages/*",
    "host",
    "voice-gateway",
    "dialogue-web"
  ],
  "devDependencies": {
    "@vscode/tree-sitter-wasm": "0.3.1",
    "web-tree-sitter": "0.26.11"
  }
}
