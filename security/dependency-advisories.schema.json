{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamebuddy.invalid/security/dependency-advisories-v1.schema.json",
  "title": "GameBuddy dependency advisory snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactKind", "snapshotId", "generatedAt", "scanner", "lockfiles", "advisories"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactKind": { "const": "dependency_advisory_snapshot" },
    "snapshotId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "scanner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "version", "status", "command"],
      "properties": {
        "identity": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "status": { "enum": ["complete", "unavailable", "unknown_blocking"] },
        "command": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "lockfiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pnpm-lock.yaml", "vendor/magic-context/bun.lock", "integrations/stardew/packages.lock.json"],
      "properties": {
        "pnpm-lock.yaml": { "$ref": "#/$defs/lockIdentity" },
        "vendor/magic-context/bun.lock": { "$ref": "#/$defs/lockIdentity" },
        "integrations/stardew/packages.lock.json": { "$ref": "#/$defs/lockIdentity" }
      }
    },
    "advisories": {
      "type": "array",
      "items": { "$ref": "#/$defs/advisory" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "lockIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present", "sha256"],
      "properties": {
        "present": { "type": "boolean" },
        "sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
      }
    },
    "advisory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["advisoryId", "ecosystem", "package", "purl", "affectedVersion", "severity", "fixedVersion", "scope", "dependencyPath", "reachabilityEvidence", "lockfileHashes", "scannerIdentity", "status"],
      "properties": {
        "advisoryId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "ecosystem": { "enum": ["npm", "bun", "nuget", "other"] },
        "package": { "type": "string", "minLength": 1, "maxLength": 256 },
        "purl": { "type": "string", "pattern": "^pkg:[^\\s]+$" },
        "affectedVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "severity": { "enum": ["critical", "high", "moderate", "low", "unknown"] },
        "fixedVersion": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 128 }, { "type": "null" }] },
        "scope": { "enum": ["runtime", "build", "test", "external-not-distributed"] },
        "dependencyPath": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
        "reachabilityEvidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } },
        "lockfileHashes": { "$ref": "#/$defs/lockHashes" },
        "scannerIdentity": { "type": "string", "minLength": 1, "maxLength": 128 },
        "status": { "enum": ["fixed", "not_affected", "mitigated", "proposed_acceptance", "accepted"] }
      }
    },
    "lockHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pnpm-lock.yaml", "vendor/magic-context/bun.lock", "integrations/stardew/packages.lock.json"],
      "properties": {
        "pnpm-lock.yaml": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "vendor/magic-context/bun.lock": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "integrations/stardew/packages.lock.json": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
      }
    }
  }
}
