{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamebuddy.invalid/security/dependency-risk-acceptances-v1.schema.json",
  "title": "GameBuddy proposed dependency risk acceptance v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactKind", "snapshotId", "lockfileHashes", "records"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactKind": { "const": "dependency_risk_acceptances" },
    "snapshotId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
    "lockfileHashes": { "$ref": "#/$defs/lockHashes" },
    "records": { "type": "array", "items": { "$ref": "#/$defs/record" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "lockHashes": {
      "type": "object", "additionalProperties": false,
      "required": ["pnpm-lock.yaml", "vendor/magic-context/bun.lock", "integrations/stardew/packages.lock.json"],
      "properties": {
        "pnpm-lock.yaml": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "vendor/magic-context/bun.lock": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "integrations/stardew/packages.lock.json": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
      }
    },
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["advisoryId", "package", "purl", "affectedVersion", "resolvedVersion", "severity", "scope", "dependencyPath", "scannerIdentity", "lockfileHashes", "status", "owner", "approvalAuthority", "approvalEvidence", "rationale", "mitigation", "verificationCommand", "createdAt", "expiresAt", "reviewBy"],
      "properties": {
        "advisoryId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "package": { "type": "string", "minLength": 1, "maxLength": 256 },
        "purl": { "type": "string", "pattern": "^pkg:[^\\s]+$" },
        "affectedVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "resolvedVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "severity": { "enum": ["critical", "high", "moderate", "low", "unknown"] },
        "scope": { "enum": ["runtime", "build", "test", "external-not-distributed"] },
        "dependencyPath": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
        "scannerIdentity": { "type": "string", "minLength": 1, "maxLength": 128 },
        "lockfileHashes": { "$ref": "#/$defs/lockHashes" },
        "status": { "const": "proposed_acceptance" },
        "owner": { "type": "string", "minLength": 1, "maxLength": 256 },
        "approvalAuthority": { "type": "string", "minLength": 1, "maxLength": 256 },
        "approvalEvidence": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "mitigation": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "verificationCommand": { "type": "string", "minLength": 1, "maxLength": 512 },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "reviewBy": { "type": "string", "format": "date-time" }
      }
    }
  }
}
