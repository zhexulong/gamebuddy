{
  "path": [
    "host/src",
    "host/scripts",
    "dialogue-web/src",
    "packages",
    "tools",
    "integrations/stardew",
    "desktop"
  ],
  "minTokens": 40,
  "minLines": 5,
  "ignore": [
    "**/vendor/**",
    "**/ref/**",
    "**/tmp/**",
    "**/.worktrees/**",
    "**/dist*/**",
    "**/*.test.*",
    "**/node_modules/**",
    "**/.commit-validation/**",
    "**/tools/lib/**",
    "**/bin/**",
    "**/obj/**",
    "**/tests/**",
    "**/GameBuddy.Desktop.Tests/**"
  ],
  "blame": false,
  "format": [
    "javascript",
    "typescript",
    "csharp"
  ],
  "reporters": [
    "console"
  ]
}
