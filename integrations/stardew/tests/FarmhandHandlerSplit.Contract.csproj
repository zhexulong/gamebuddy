<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>FarmhandHandlerSplit.Contract</AssemblyName>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!-- Building this contract also compiles the referenced Mod, so the
       caller-supplied digest is computed over the artifact of the same
       build invocation. This executable itself never loads the Mod or the
       game assemblies; it inspects the caller-selected DLL via metadata and
       IL only, against a caller-supplied SHA-256 binding. -->
  <ItemGroup>
    <ProjectReference Include="..\GameBuddy.Stardew.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="FarmhandHandlerSplitContractProgram.cs" />
    <Compile Include="FarmhandHandlerSplitContractTests.cs" />
  </ItemGroup>
</Project>
