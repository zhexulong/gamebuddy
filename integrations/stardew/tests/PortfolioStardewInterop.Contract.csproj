<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The production assembly grants friend access to the exact assembly
         name PortfolioMineElevatorProjection.Contract (see
         ../InternalsVisibleTo.cs). This standalone peer keeps that identity so
         it can use the production PortfolioLocalPipeBridge / PortfolioBridgeSession /
         coordinator / protocol types directly. The post-build target below
         publishes the frozen cross-process peer file name that the Node
         contract launches:
         integrations/stardew/tests/bin/Release/net6.0/PortfolioStardewInterop.Contract.dll
         (dotnet <file> resolves the runtimeconfig/deps named after that file).
         The peer builds into its own output subdirectory so it never clobbers
         the same-named sibling contract suite assembly in the shared output
         directory. -->
    <AssemblyName>PortfolioMineElevatorProjection.Contract</AssemblyName>
    <TargetFramework>net6.0</TargetFramework>
    <OutputPath>bin\Release\net6.0\portfolio-interop\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GamePath Condition="'$(GamePath)' == '' and '$(GAMEBUDDY_STARDEW_GAME_PATH)' != ''">$(GAMEBUDDY_STARDEW_GAME_PATH)</GamePath>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameBuddy.Stardew.csproj" />
  </ItemGroup>

  <!-- The peer instantiates the compiled ModEntry (SMAPI Mod subclass) for the
       exact private drain reflection path, so it must carry the same
       target-version runtime dependencies as the production Mod. -->
  <ItemGroup Condition="'$(GamePath)' != ''">
    <Reference Include="StardewModdingAPI">
      <HintPath>$(GamePath)\StardewModdingAPI.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Stardew Valley">
      <HintPath>$(GamePath)\Stardew Valley.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="MonoGame.Framework">
      <HintPath>$(GamePath)\MonoGame.Framework.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GamePath)\smapi-internal\Newtonsoft.Json.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="PortfolioStardewInteropProgram.cs" />
  </ItemGroup>

  <!-- Publish the frozen peer file names next to the ordinary shared contract
       outputs, plus the production runtime dependencies the peer loads. The
       assembly identity stays PortfolioMineElevatorProjection.Contract for
       friend access; only the file names differ. The copied deps.json is
       patched so the app assembly resolves from the renamed dll (the .NET host
       resolves the app by deps entry, which would otherwise load the sibling
       contract suite's same-named assembly from this shared directory). The
       apphost exe is intentionally not published: it embeds the identity dll
       name at build time. -->
  <Target Name="PublishPortfolioStardewInteropPeerFiles" AfterTargets="Build">
    <PropertyGroup>
      <PortfolioSharedOutDir>$([System.IO.Path]::GetFullPath('$(TargetDir)..\'))</PortfolioSharedOutDir>
      <PortfolioPeerDepsJson>$([System.IO.File]::ReadAllText('$(TargetDir)$(AssemblyName).deps.json').Replace('$(AssemblyName).dll', 'PortfolioStardewInterop.Contract.dll'))</PortfolioPeerDepsJson>
    </PropertyGroup>
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(PortfolioSharedOutDir)PortfolioStardewInterop.Contract.dll" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pdb" DestinationFiles="$(PortfolioSharedOutDir)PortfolioStardewInterop.Contract.pdb" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).runtimeconfig.json" DestinationFiles="$(PortfolioSharedOutDir)PortfolioStardewInterop.Contract.runtimeconfig.json" />
    <WriteLinesToFile File="$(PortfolioSharedOutDir)PortfolioStardewInterop.Contract.deps.json" Lines="$(PortfolioPeerDepsJson)" Overwrite="true" />
    <Copy SourceFiles="@(ReferenceCopyLocalPaths)" DestinationFolder="$(PortfolioSharedOutDir)" Condition="'@(ReferenceCopyLocalPaths)' != ''" />
  </Target>
</Project>
