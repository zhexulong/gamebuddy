<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableModDeploy>false</EnableModDeploy>
    <EnableModZip>false</EnableModZip>
    <GamePath Condition="'$(GamePath)' == '' and '$(GAMEBUDDY_STARDEW_GAME_PATH)' != ''">$(GAMEBUDDY_STARDEW_GAME_PATH)</GamePath>
    <GamePath Condition="'$(GamePath)' == ''">D:\Steam\steamapps\common\Stardew Valley</GamePath>
    <RootNamespace>GameBuddy.Stardew.Integration.Tests</RootNamespace>
    <AssemblyName>GameBuddy.Stardew.Integration.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="6.12.2" />
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(GamePath)')">
    <None Include="$(GamePath)\*.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(GamePath)\smapi-internal\*.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!--
    Harmony is what the Mod itself patches through, and `tools/live-run`'s gates for it can only be honest if they can
    install the same patch: `BodyHoldProbeTests` patches the engine's own `Farmer.CanMove` setter in this process and
    checks that a fourth site is named. SMAPI ships `0Harmony.dll` beside the game, so the reference is that copy - the
    same assembly the Mod's `EnableHarmony` wires at runtime, not a second version of it.
  -->
  <ItemGroup Condition="Exists('$(GamePath)\smapi-internal\0Harmony.dll')">
    <Reference Include="0Harmony">
      <HintPath>$(GamePath)\smapi-internal\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\GameBuddy.Stardew.csproj" />
    <ProjectReference Include="..\..\src\Core\GameBuddy.Stardew.Core.csproj" />
    <Compile Include="..\FarmhandLocalPipeBridgeDeliveryTests.cs" Link="FarmhandLocalPipeBridgeDeliveryTests.cs" />
    <Compile Include="..\CompanionPresentationPolicyTests.cs" Link="CompanionPresentationPolicyTests.cs" />
  </ItemGroup>
</Project>
