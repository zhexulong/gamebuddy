<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableHarmony>true</EnableHarmony>
    <EnableModDeploy>false</EnableModDeploy>
    <EnableModZip>false</EnableModZip>
    <!--
      One directory name for one mod. `ModFolderName` otherwise defaults to the
      project name (`GameBuddy.Stardew`), while every fixture path in this repo
      deploys to and reads from `Mods/GameBuddy`. That split made SMAPI see the
      mod twice - the fixture wrote `GameBuddy/`, an older `GameBuddy.Stardew/`
      sat beside it, SMAPI refused the duplicate by UniqueID and started WITHOUT
      the mod, the bridge pipe never appeared, and the run reported
      `stardew_pipe_not_listening` after a 150 second wait. Removing a folder by
      hand did not help: the fixture restores what it deployed.

      `check-stardew-mod-folder-name.mjs` asserts the three places agree.
    -->
    <ModFolderName>GameBuddy</ModFolderName>
    <BundleExtraAssemblies>ThirdParty</BundleExtraAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="src\Core\GameBuddy.Stardew.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="src\Core\**\*.cs" />
    <Compile Remove="action-development\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The window-mode contract mapping is pure game-side glue: it is asserted by
         the Mod's own test project instead of widening the public surface. -->
    <InternalsVisibleTo Include="GameBuddy.Stardew.Integration.Tests" />
  </ItemGroup>


  <ItemGroup>
    <None Update="manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
