{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gamebuddy-action-descriptors/v1",
  "title": "GameBuddy action descriptors v1",
  "description": "A bounded, non-authoritative consumer artifact containing producer-published action descriptors.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "catalogRevision",
    "actions"
  ],
  "properties": {
    "schema": {
      "const": "gamebuddy-action-descriptors/v1"
    },
    "catalogRevision": {
      "type": "integer",
      "minimum": 0
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "description": "Registration actionId values are unique within this surface; keyed uniqueness is enforced by the gamebuddy v1 validator.",
      "x-gamebuddy-uniqueBy": "actionId",
      "items": {
        "$ref": "#/$defs/action"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,127}$",
      "minLength": 2,
      "maxLength": 128
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actionId",
        "identityVersion",
        "lifecycle",
        "kind",
        "argumentSchema",
        "outputFacts",
        "resourceTemplate",
        "effect",
        "postcondition"
      ],
      "properties": {
        "actionId": {
          "$ref": "#/$defs/identifier"
        },
        "identityVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "lifecycle": {
          "enum": [
            "published",
            "experimental"
          ]
        },
        "kind": {
          "enum": [
            "execution",
            "read_only"
          ]
        },
        "argumentSchema": { "type": "object" },
        "outputFacts": { "type": "object" },
        "resourceTemplate": {
          "type": "object",
          "required": ["claims"],
          "additionalProperties": false,
          "properties": {
            "claims": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["key", "value"],
                "additionalProperties": false,
                "properties": {
                  "key": { "$ref": "#/$defs/identifier" },
                  "value": { "type": "string", "const": "ScopePlayer" }
                }
              }
            }
          }
        },
        "effect": { "enum": ["read", "write"] },
        "postcondition": {
          "type": "object",
          "required": ["name"],
          "additionalProperties": false,
          "properties": { "name": { "type": "string" } }
        }
      }
    }
  }
}
