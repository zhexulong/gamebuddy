{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gamebuddy-action-descriptors/v1",
  "title": "GameBuddy action descriptors v1",
  "description": "A bounded, non-authoritative consumer artifact containing producer-published action descriptors.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "catalogRevision",
    "actions"
  ],
  "properties": {
    "schema": {
      "const": "gamebuddy-action-descriptors/v1"
    },
    "catalogRevision": {
      "type": "integer",
      "minimum": 0
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "description": "Registration actionId values are unique within this surface; keyed uniqueness is enforced by the gamebuddy v1 validator.",
      "x-gamebuddy-uniqueBy": "actionId",
      "items": {
        "$ref": "#/$defs/action"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,127}$",
      "minLength": 2,
      "maxLength": 128
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actionId",
        "identityVersion",
        "argumentSchema",
        "outputFacts",
        "resourceTemplate",
        "effect",
        "postcondition",
        "lifecycle",
        "kind"
      ],
      "properties": {
        "actionId": {
          "$ref": "#/$defs/identifier"
        },
        "identityVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "lifecycle": {
          "enum": [
            "published",
            "live_verified",
            "experimental"
          ]
        },
        "kind": {
          "enum": [
            "execution",
            "read_only"
          ]
        },
        "argumentSchema": { "type": "object" },
        "outputFacts": { "type": "object" },
        "resourceTemplate": {
          "type": "object",
          "required": ["claims"],
          "additionalProperties": false,
          "properties": {
            "claims": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["key", "value"],
                "additionalProperties": false,
                "properties": {
                  "key": { "$ref": "#/$defs/identifier" },
                  "value": { "type": "string", "const": "ScopePlayer" }
                }
              }
            }
          }
        },
        "effect": { "enum": ["read", "write"] },
        "effects": {
          "type": "object",
          "required": ["declared"],
          "additionalProperties": false,
          "properties": {
            "declared": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "required": ["class", "subject", "observedBy"],
                "additionalProperties": false,
                "properties": {
                  "class": { "enum": ["moves_actor", "requires_place", "produces", "consumes"] },
                  "subject": { "type": "string" },
                  "observedBy": { "type": "string" }
                }
              }
            },
            "none": {
              "anyOf": [
                { "enum": ["observation_only", "actor_body_only", "addressed_row_only", "game_owned_ledger"] },
                {
                  "type": "string",
                  "pattern": "^resource_unproven_by_the_receipt:[a-z][a-z0-9_]{1,63}$",
                  "description": "The action moves a resource and no receipt fact names which: the marker names the resource, because a bare marker is the same hole wearing a word."
                }
              ]
            }
          }
        },
        "postcondition": {
          "type": "object",
          "required": ["name"],
          "additionalProperties": false,
          "properties": { "name": { "type": "string" } }
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "What the action is called in the tool a model is handed. Published with description and targetKinds or not at all: an action that publishes none writes its tool text in its own mount block, and an absent member is that statement rather than an empty string."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "The sentence a model reads about the action itself (an argument's own meaning is described on its argumentSchema entry). 2048 is above the longest sentence the Mod publishes today, 1437, and is the ceiling its producer declares."
        },
        "targetKinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
          "description": "The kinds of thing the action acts on (world_object, modal, pet), the words a caller's own search is matched against."
        }
      }
    }
  }
}
