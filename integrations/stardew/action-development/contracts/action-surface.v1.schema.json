{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gamebuddy-stardew-action-surface/v1",
  "title": "GameBuddy Stardew static action surface v1",
  "description": "A bounded, non-authoritative consumer artifact containing only producer-published registration identity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "gameId",
    "registrations"
  ],
  "properties": {
    "schema": {
      "const": "gamebuddy-stardew-action-surface/v1"
    },
    "gameId": {
      "const": "stardew"
    },
    "registrations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "description": "Registration actionId values are unique within this surface; keyed uniqueness is enforced by the gamebuddy v1 validator.",
      "x-gamebuddy-uniqueBy": "actionId",
      "items": {
        "$ref": "#/$defs/registration"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,127}$",
      "minLength": 2,
      "maxLength": 128
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actionId",
        "familyId",
        "identityVersion",
        "lifecycle",
        "kind"
      ],
      "properties": {
        "actionId": {
          "$ref": "#/$defs/identifier"
        },
        "familyId": {
          "$ref": "#/$defs/identifier"
        },
        "identityVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "lifecycle": {
          "enum": [
            "published",
            "experimental"
          ]
        },
        "kind": {
          "enum": [
            "execution",
            "read_only"
          ]
        }
      }
    }
  }
}
