[Nn][Uu][Ll]
.DS_Store
Thumbs.db

# Node.js
node_modules/
dist/
# Disposable Host verification outputs. Production runners must resolve the
# immutable generation via host/scripts/production-artifact.mjs; tests own
# host/dist-test only through host/.test-artifact.lock.
host/dist-test/
host/.dist-production-emitted/
host/.memory-live-check/
dialogue-web/.build-staging/
# Ephemeral isolated Host/Pi runtime roots; may contain local SQLite/auth/session state.
host/contexts/
dist-portfolio/
# Test and verification evidence outputs are local by default; committed fixtures
# and source-realization dossiers live under fixtures/ and tools/ instead.
/artifacts/
# Contract executables and package builds are reconstructed locally.
/integrations/stardew/tests/bin/
/integrations/stardew/tests/obj/
/packages/voice-protocol/dist/
coverage/
*.tsbuildinfo

# .NET / SMAPI
[Bb]in/
!packages/game-action-devkit/bin/
!packages/game-action-devkit/bin/game-action.mjs
[Oo]bj/
TestResults/
# NuGet restores and native helper publish outputs are always local/rebuildable.
**/NuGet/
**/.dist/
stardewvalley.targets
*.user
*.suo
*.userosscache
*.sln.docstates

