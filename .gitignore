# Live-run evidence: one local directory per run (git-ignored). Reviewers read
# these when auditing a run; they are never committed or shared. See
# tools/live-run/README.md.
/.live-runs/
/.audit-runs/

# Live-run diagnostic result files (never committed; archive deliberately under
# tools/fixtures/ when a run deserves evidence).
/_*.result.json
/_*.log
/tools/_*.result.json

# Any stray live-run evidence directory (the capture root must be the repo
# root; this also catches a mis-resolved root so evidence can never be staged).
.live-runs/
