# GameBuddy-owned text is always LF so diagnostics and snapshots do not depend on core.autocrlf.
* text=auto eol=lf

# Windows batch files must keep CRLF: cmd.exe misparses a .cmd that uses bare LF, reporting
# "was unexpected at this time" instead of running it. That failure was measured on
# tools/sandbox/sandbox-verify.cmd, which then reported nothing at all - the script never started.
*.cmd text eol=crlf
*.bat text eol=crlf

# Explicit binary assets must never be EOL-normalized.
*.7z binary
*.bmp binary
*.dll binary
*.exe binary
*.gif binary
*.ico binary
*.jar binary
*.jpeg binary
*.jpg binary
*.mp3 binary
*.mp4 binary
*.nupkg binary
*.pdf binary
*.png binary
*.so binary
*.tar binary
*.tgz binary
*.wasm binary
*.webm binary
*.woff binary
*.woff2 binary
*.zip binary
