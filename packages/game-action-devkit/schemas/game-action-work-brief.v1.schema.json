{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamebuddy.local/game-action-devkit/schemas/game-action-work-brief.v1.schema.json",
  "title": "GameBuddy frozen action work brief v1",
  "description": "Task-local collaboration facts. This brief grants no gameplay, merge, publication, or live authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "gameId",
    "actionId",
    "baseCommit",
    "contractVersion",
    "status",
    "effect",
    "claimScope",
    "ownedPaths",
    "sharedHubs",
    "requiredPortfolioEntries",
    "checks",
    "liveAuthorized"
  ],
  "properties": {
    "schema": {
      "const": "gamebuddy-action-work-brief/v1"
    },
    "gameId": {
      "$ref": "#/$defs/identifier"
    },
    "actionId": {
      "$ref": "#/$defs/identifier"
    },
    "baseCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "contractVersion": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "const": "frozen"
    },
    "effect": {
      "enum": [
        "read_only",
        "mutation"
      ]
    },
    "claimScope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "ownedPaths": {
      "$ref": "#/$defs/pathPatterns"
    },
    "sharedHubs": {
      "$ref": "#/$defs/pathPatterns"
    },
    "requiredPortfolioEntries": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "liveAuthorized": {
      "type": "boolean"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*\\u0000)(?!.*\\u0001)(?!.*\\u0002)(?!.*\\u0003)(?!.*\\u0004)(?!.*\\u0005)(?!.*\\u0006)(?!.*\\u0007)(?!.*\\u0008)(?!.*\\u0009)(?!.*\\u000A)(?!.*\\u000B)(?!.*\\u000C)(?!.*\\u000D)(?!.*\\u000E)(?!.*\\u000F)(?!.*\\u0010)(?!.*\\u0011)(?!.*\\u0012)(?!.*\\u0013)(?!.*\\u0014)(?!.*\\u0015)(?!.*\\u0016)(?!.*\\u0017)(?!.*\\u0018)(?!.*\\u0019)(?!.*\\u001A)(?!.*\\u001B)(?!.*\\u001C)(?!.*\\u001D)(?!.*\\u001E)(?!.*\\u001F)(?!.*\\u007F)(?!.*\\.\\.)(?!.*//)(?!.*(?:^|/)\\.(?:/|$))(?!.*\\*(?!\\*$)).+$"
    },
    "pathPattern": {
      "anyOf": [
        {
          "$ref": "#/$defs/repositoryPath"
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/repositoryPath"
            },
            {
              "type": "string",
              "pattern": "/\\*\\*$"
            }
          ]
        }
      ]
    },
    "pathPatterns": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/pathPattern"
      }
    }
  }
}
