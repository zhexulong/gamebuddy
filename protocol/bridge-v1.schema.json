        "friendshipStatus": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "talkedToToday": {
          "type": "boolean"
        },
        "giftsToday": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "giftsThisWeek": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        }
      }
    },
    "petTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetId",
        "x",
        "y",
