    "foodTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "qualifiedItemId",
        "stack",
        "edibility",
        "isDrink"
      ],
      "properties": {
        "slot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 36
        },
        "qualifiedItemId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "stack": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999
        },
        "edibility": {
          "type": "integer",
          "minimum": -299,
          "maximum": 1000
        },
        "isDrink": {
          "type": "boolean"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "location",
        "tile",
        "stamina",
        "health",
        "actionable",
        "capabilities"
      ],
      "properties": {
        "revision": {
          "type": "integer"
        },
        "location": {
          "type": "string"
        },
        "tile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          }
        },
        "stamina": {
          "type": "number"
        },
        "health": {
          "type": "number"
        },
        "currentTool": {
          "type": [
            "string",
            "null"
          ]
        },
        "inventorySlots": {
          "type": "integer",
          "minimum": 0,
          "maximum": 36
        },
        "actionable": {
          "type": "boolean"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 128
          },
          "maxItems": 128
        },
        "activeExecution": {
