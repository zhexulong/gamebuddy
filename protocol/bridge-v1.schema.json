        "friendship",
        "pettedToday"
      ],
      "properties": {
        "targetId": {
          "$ref": "#/$defs/opaqueId"
        },
        "x": {
          "$ref": "#/$defs/tile"
        },
        "y": {
          "$ref": "#/$defs/tile"
        },
        "petType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "friendship": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "pettedToday": {
          "const": false
        }
      }
    },
    "animalProductTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetId",
        "slot",
        "x",
        "y",
        "animalType",
        "qualifiedProduceItemId",
        "toolKind",
        "produceStack"
      ],
      "properties": {
        "targetId": {
          "$ref": "#/$defs/opaqueId"
        },
        "slot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 36
        },
        "x": {
          "$ref": "#/$defs/tile"
        },
        "y": {
          "$ref": "#/$defs/tile"
        },
        "animalType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "qualifiedProduceItemId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "toolKind": {
          "enum": [
            "milk_pail",
            "shears"
          ]
        },
        "produceStack": {
          "enum": [
            1,
            2
          ]
        }
      }
    },
    "feedTroughTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetId",
        "slot",
