          "$ref": "#/$defs/opaqueId"
        },
        "x": {
          "$ref": "#/$defs/tile"
        },
        "y": {
          "$ref": "#/$defs/tile"
        },
        "qualifiedItemId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "stack": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999
        }
      }
    },
    "itemTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetId",
        "x",
        "y",
        "qualifiedItemId",
        "stack"
      ],
      "properties": {
        "targetId": {
          "$ref": "#/$defs/opaqueId"
        },
        "x": {
          "$ref": "#/$defs/tile"
        },
        "y": {
          "$ref": "#/$defs/tile"
        },
        "qualifiedItemId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "stack": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999
        }
      }
    },
    "cropTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetId",
        "x",
        "y",
        "cropId"
      ],
      "properties": {
        "targetId": {
          "$ref": "#/$defs/opaqueId"
        },
        "x": {
          "$ref": "#/$defs/tile"
        },
        "y": {
          "$ref": "#/$defs/tile"
        },
        "cropId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "harvestTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetId",
        "x",
        "y",
        "cropId",
        "qualifiedHarvestItemId",
        "regrowsAfterHarvest"
      ],
      "properties": {
        "targetId": {
          "$ref": "#/$defs/opaqueId"
        },
        "x": {
          "$ref": "#/$defs/tile"
        },
        "y": {
          "$ref": "#/$defs/tile"
        },
        "cropId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "qualifiedHarvestItemId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "regrowsAfterHarvest": {
          "type": "boolean"
        }
      }
    },
    "seedTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetId",
        "slot",
        "x",
        "y",
        "qualifiedItemId"
      ],
      "properties": {
        "targetId": {
          "$ref": "#/$defs/opaqueId"
        },
        "slot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 36
        },
        "x": {
          "$ref": "#/$defs/tile"
        },
        "y": {
          "$ref": "#/$defs/tile"
        },
        "qualifiedItemId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "fertilizerTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetId",
        "slot",
        "x",
        "y",
        "qualifiedItemId"
      ],
      "properties": {
        "targetId": {
          "$ref": "#/$defs/opaqueId"
        },
        "slot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 36
        },
        "x": {
          "$ref": "#/$defs/tile"
        },
        "y": {
          "$ref": "#/$defs/tile"
        },
        "qualifiedItemId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "debrisTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetId",
        "slot",
        "x",
        "y",
        "parentSheetIndex",
        "toolKind",
        "requiredUpgradeLevel",
        "health"
      ],
      "properties": {
        "targetId": {
          "$ref": "#/$defs/opaqueId"
        },
        "slot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 36
        },
        "x": {
          "$ref": "#/$defs/tile"
        },
        "y": {
          "$ref": "#/$defs/tile"
        },
        "parentSheetIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000
        },
        "toolKind": {
          "enum": [
            "axe",
            "pickaxe"
          ]
        },
        "requiredUpgradeLevel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "health": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "machineTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetId",
        "x",
        "y",
        "qualifiedItemId",
        "readyForHarvest",
        "minutesUntilReady"
      ],
      "properties": {
        "targetId": {
          "$ref": "#/$defs/opaqueId"
        },
        "x": {
          "$ref": "#/$defs/tile"
        },
        "y": {
          "$ref": "#/$defs/tile"
        },
        "qualifiedItemId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "readyForHarvest": {
          "type": "boolean"
        },
        "minutesUntilReady": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "heldObjectQualifiedItemId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "lastInputQualifiedItemId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "loadInputSlot": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 36
        },
        "loadInputQualifiedItemId": {
          "anyOf": [{ "type": "null" }, { "const": "(O)433" }]
        },
        "loadInputStack": {
          "anyOf": [{ "type": "null" }, { "const": 5 }]
        },
        "collectOutputReady": {
          "type": ["boolean", "null"]
        }
      }
    },
    "treeChopSourceTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetId", "location", "x", "y", "treeType", "growthStage", "health", "stump", "moss", "tapped"],
      "properties": {
        "targetId": { "$ref": "#/$defs/opaqueId" },
        "location": { "type": "string", "minLength": 1, "maxLength": 256 },
        "x": { "$ref": "#/$defs/tile" },
        "y": { "$ref": "#/$defs/tile" },
        "treeType": { "type": "string", "minLength": 1, "maxLength": 32 },
        "growthStage": { "type": "integer", "minimum": 5, "maximum": 20 },
        "health": { "const": 1 },
        "stump": { "const": false },
        "moss": { "const": false },
        "tapped": { "const": false }
      }
    },
    "treeChopResultTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetId", "location", "x", "y", "treeType", "health", "stump", "moss", "tapped"],
      "properties": {
        "targetId": { "$ref": "#/$defs/opaqueId" },
        "location": { "type": "string", "minLength": 1, "maxLength": 256 },
        "x": { "$ref": "#/$defs/tile" },
        "y": { "$ref": "#/$defs/tile" },
        "treeType": { "type": "string", "minLength": 1, "maxLength": 32 },
        "health": { "const": 5 },
        "stump": { "const": true },
        "moss": { "const": false },
        "tapped": { "const": false }
      }
    },
    "treeShakeSourceTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetId",
        "location",
        "x",
        "y",
        "treeType",
        "growthStage",
        "health",
        "moss",
        "tapped"
      ],
      "properties": {
        "targetId": {
          "$ref": "#/$defs/opaqueId"
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "x": {
          "$ref": "#/$defs/tile"
        },
        "y": {
          "$ref": "#/$defs/tile"
        },
        "treeType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "growthStage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "health": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        },
        "moss": {
          "type": "boolean"
        },
        "tapped": {
          "type": "boolean"
        }
      }
    },
    "npcRelationshipTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetId",
        "x",
        "y",
        "npcName",
        "friendshipPoints",
        "friendshipStatus",
        "talkedToToday",
        "giftsToday",
        "giftsThisWeek"
      ],
      "properties": {
        "targetId": {
          "$ref": "#/$defs/opaqueId"
        },
        "x": {
          "$ref": "#/$defs/tile"
        },
        "y": {
          "$ref": "#/$defs/tile"
        },
        "npcName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "friendshipPoints": {
          "type": "integer",
          "minimum": -1,
          "maximum": 10000
