{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamebuddy.local/protocol/bridge-v1.schema.json",
  "title": "GameBuddy local bridge v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "messageId", "correlationId", "timestampMs", "scope", "type", "payload"],
  "properties": {
    "protocolVersion": { "const": 1 },
    "messageId": { "$ref": "#/$defs/opaqueId" },
    "correlationId": { "$ref": "#/$defs/opaqueId" },
    "timestampMs": { "type": "integer" },
    "scope": { "$ref": "#/$defs/scope" },
    "type": { "enum": ["hello", "hello_ack", "observe_request", "snapshot", "execution_request", "cancel_request", "execution_receipt", "error", "semantic_event", "lifecycle"] },
    "payload": { "type": "object" }
  },
  "allOf": [
    { "if": { "properties": { "type": { "const": "hello" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/hello" } } } },
    { "if": { "properties": { "type": { "const": "hello_ack" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/helloAck" } } } },
    { "if": { "properties": { "type": { "const": "observe_request" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/empty" } } } },
    { "if": { "properties": { "type": { "const": "snapshot" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/snapshot" } } } },
    { "if": { "properties": { "type": { "const": "execution_request" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/executionRequest" } } } },
    { "if": { "properties": { "type": { "const": "cancel_request" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/cancelRequest" } } } },
    { "if": { "properties": { "type": { "const": "execution_receipt" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/receipt" } } } },
    { "if": { "properties": { "type": { "const": "error" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/error" } } } },
    { "if": { "properties": { "type": { "const": "semantic_event" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/semanticEvent" } } } },
    { "if": { "properties": { "type": { "const": "lifecycle" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/lifecycle" } } } }
  ],
  "$defs": {
    "opaqueId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
    "token": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,256}$" },
    "reasonCode": { "type": "string", "pattern": "^[a-z0-9_:-]{1,128}$" },
    "tile": { "type": "integer", "minimum": 0, "maximum": 1000 },
    "scope": { "type": "object", "additionalProperties": false, "required": ["integrationId", "saveId", "worldId", "playerId", "companionId"], "properties": { "integrationId": { "$ref": "#/$defs/opaqueId" }, "saveId": { "$ref": "#/$defs/opaqueId" }, "worldId": { "$ref": "#/$defs/opaqueId" }, "playerId": { "$ref": "#/$defs/opaqueId" }, "companionId": { "$ref": "#/$defs/opaqueId" } } },
    "empty": { "type": "object", "additionalProperties": false },
    "hello": { "type": "object", "additionalProperties": false, "required": ["token"], "properties": { "token": { "$ref": "#/$defs/token" } } },
    "helloAck": { "type": "object", "additionalProperties": false, "required": ["sessionId", "capabilities"], "properties": { "sessionId": { "$ref": "#/$defs/opaqueId" }, "capabilities": { "type": "array", "items": { "type": "string", "maxLength": 128 }, "maxItems": 128 } } },
    "activeExecution": { "type": "object", "additionalProperties": false, "required": ["executionId", "requestId", "action", "state", "reasonCode", "evidence"], "properties": { "executionId": { "$ref": "#/$defs/opaqueId" }, "requestId": { "$ref": "#/$defs/opaqueId" }, "action": { "type": "string", "maxLength": 128 }, "state": { "$ref": "#/$defs/executionState" }, "reasonCode": { "$ref": "#/$defs/reasonCode" }, "evidence": { "type": ["object", "null"] } } },
    "warp": { "type": "object", "additionalProperties": false, "required": ["sourceX", "sourceY", "targetLocation", "targetX", "targetY"], "properties": { "sourceX": { "$ref": "#/$defs/tile" }, "sourceY": { "$ref": "#/$defs/tile" }, "targetLocation": { "type": "string", "minLength": 1, "maxLength": 256 }, "targetX": { "$ref": "#/$defs/tile" }, "targetY": { "$ref": "#/$defs/tile" } } },
    "soilTile": { "type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": { "x": { "$ref": "#/$defs/tile" }, "y": { "$ref": "#/$defs/tile" } } },
    "toolSlot": { "type": "object", "additionalProperties": false, "required": ["slot", "label"], "properties": { "slot": { "type": "integer", "minimum": 0, "maximum": 36 }, "label": { "type": "string", "minLength": 1, "maxLength": 128 } } },
    "forageTarget": { "type": "object", "additionalProperties": false, "required": ["targetId", "x", "y", "qualifiedItemId", "stack"], "properties": { "targetId": { "$ref": "#/$defs/opaqueId" }, "x": { "$ref": "#/$defs/tile" }, "y": { "$ref": "#/$defs/tile" }, "qualifiedItemId": { "type": "string", "minLength": 1, "maxLength": 128 }, "stack": { "type": "integer", "minimum": 1, "maximum": 999 } } },
    "itemTarget": { "type": "object", "additionalProperties": false, "required": ["targetId", "x", "y", "qualifiedItemId", "stack"], "properties": { "targetId": { "$ref": "#/$defs/opaqueId" }, "x": { "$ref": "#/$defs/tile" }, "y": { "$ref": "#/$defs/tile" }, "qualifiedItemId": { "type": "string", "minLength": 1, "maxLength": 128 }, "stack": { "type": "integer", "minimum": 1, "maximum": 999 } } },
    "cropTarget": { "type": "object", "additionalProperties": false, "required": ["targetId", "x", "y", "cropId"], "properties": { "targetId": { "$ref": "#/$defs/opaqueId" }, "x": { "$ref": "#/$defs/tile" }, "y": { "$ref": "#/$defs/tile" }, "cropId": { "type": "string", "minLength": 1, "maxLength": 128 } } },
    "harvestTarget": { "type": "object", "additionalProperties": false, "required": ["targetId", "x", "y", "cropId", "qualifiedHarvestItemId", "regrowsAfterHarvest"], "properties": { "targetId": { "$ref": "#/$defs/opaqueId" }, "x": { "$ref": "#/$defs/tile" }, "y": { "$ref": "#/$defs/tile" }, "cropId": { "type": "string", "minLength": 1, "maxLength": 128 }, "qualifiedHarvestItemId": { "type": "string", "minLength": 1, "maxLength": 128 }, "regrowsAfterHarvest": { "type": "boolean" } } },
    "seedTarget": { "type": "object", "additionalProperties": false, "required": ["targetId", "slot", "x", "y", "qualifiedItemId"], "properties": { "targetId": { "$ref": "#/$defs/opaqueId" }, "slot": { "type": "integer", "minimum": 0, "maximum": 36 }, "x": { "$ref": "#/$defs/tile" }, "y": { "$ref": "#/$defs/tile" }, "qualifiedItemId": { "type": "string", "minLength": 1, "maxLength": 128 } } },
    "fertilizerTarget": { "type": "object", "additionalProperties": false, "required": ["targetId", "slot", "x", "y", "qualifiedItemId"], "properties": { "targetId": { "$ref": "#/$defs/opaqueId" }, "slot": { "type": "integer", "minimum": 0, "maximum": 36 }, "x": { "$ref": "#/$defs/tile" }, "y": { "$ref": "#/\u0024defs/tile" }, "qualifiedItemId": { "type": "string", "minLength": 1, "maxLength": 128 } } },
    "debrisTarget": { "type": "object", "additionalProperties": false, "required": ["targetId", "slot", "x", "y", "parentSheetIndex", "toolKind", "requiredUpgradeLevel"], "properties": { "targetId": { "$ref": "#/$defs/opaqueId" }, "slot": { "type": "integer", "minimum": 0, "maximum": 36 }, "x": { "$ref": "#/$defs/tile" }, "y": { "$ref": "#/$defs/tile" }, "parentSheetIndex": { "type": "integer", "minimum": 0, "maximum": 2000 }, "toolKind": { "enum": ["axe", "pickaxe"] }, "requiredUpgradeLevel": { "type": "integer", "minimum": 0, "maximum": 4 } } },
    "machineTarget": { "type": "object", "additionalProperties": false, "required": ["targetId", "x", "y", "qualifiedItemId", "readyForHarvest", "minutesUntilReady"], "properties": { "targetId": { "$ref": "#/$defs/opaqueId" }, "x": { "$ref": "#/$defs/tile" }, "y": { "$ref": "#/$defs/tile" }, "qualifiedItemId": { "type": "string", "minLength": 1, "maxLength": 128 }, "readyForHarvest": { "type": "boolean" }, "minutesUntilReady": { "type": "integer", "minimum": 0, "maximum": 100000 }, "heldObjectQualifiedItemId": { "type": ["string", "null"], "maxLength": 128 }, "lastInputQualifiedItemId": { "type": ["string", "null"], "maxLength": 128 } } },
    "resourceTarget": { "type": "object", "additionalProperties": false, "required": ["targetId", "slot", "x", "y", "treeType", "growthStage", "stump", "health", "toolKind", "requiredUpgradeLevel"], "properties": { "targetId": { "$ref": "#/$defs/opaqueId" }, "slot": { "type": "integer", "minimum": 0, "maximum": 36 }, "x": { "$ref": "#/$defs/tile" }, "y": { "$ref": "#/$defs/tile" }, "treeType": { "type": "string", "minLength": 1, "maxLength": 32 }, "growthStage": { "type": "integer", "minimum": 0, "maximum": 20 }, "stump": { "type": "boolean" }, "health": { "type": "number", "minimum": -100, "maximum": 100 }, "toolKind": { "const": "axe" }, "requiredUpgradeLevel": { "type": "integer", "minimum": 0, "maximum": 4 } } },
    "npcRelationshipTarget": { "type": "object", "additionalProperties": false, "required": ["targetId", "x", "y", "npcName", "friendshipPoints", "friendshipStatus", "talkedToToday", "giftsToday", "giftsThisWeek"], "properties": { "targetId": { "$ref": "#/$defs/opaqueId" }, "x": { "$ref": "#/$defs/tile" }, "y": { "$ref": "#/$defs/tile" }, "npcName": { "type": "string", "minLength": 1, "maxLength": 64 }, "friendshipPoints": { "type": "integer", "minimum": -1, "maximum": 10000 }, "friendshipStatus": { "type": "string", "minLength": 1, "maxLength": 32 }, "talkedToToday": { "type": "boolean" }, "giftsToday": { "type": "integer", "minimum": 0, "maximum": 10 }, "giftsThisWeek": { "type": "integer", "minimum": 0, "maximum": 20 } } },
    "petTarget": { "type": "object", "additionalProperties": false, "required": ["targetId", "x", "y", "petType", "friendship", "pettedToday"], "properties": { "targetId": { "$ref": "#/$defs/opaqueId" }, "x": { "$ref": "#/$defs/tile" }, "y": { "$ref": "#/$defs/tile" }, "petType": { "type": "string", "minLength": 1, "maxLength": 32 }, "friendship": { "type": "integer", "minimum": 0, "maximum": 1000 }, "pettedToday": { "const": false } } },
    "animalProductTarget": { "type": "object", "additionalProperties": false, "required": ["targetId", "slot", "x", "y", "animalType", "qualifiedProduceItemId", "toolKind", "produceStack"], "properties": { "targetId": { "$ref": "#/$defs/opaqueId" }, "slot": { "type": "integer", "minimum": 0, "maximum": 36 }, "x": { "$ref": "#/$defs/tile" }, "y": { "$ref": "#/$defs/tile" }, "animalType": { "type": "string", "minLength": 1, "maxLength": 64 }, "qualifiedProduceItemId": { "type": "string", "minLength": 1, "maxLength": 128 }, "toolKind": { "enum": ["milk_pail", "shears"] }, "produceStack": { "enum": [1, 2] } } },
    "feedTroughTarget": { "type": "object", "additionalProperties": false, "required": ["targetId", "slot", "x", "y", "hayStack"], "properties": { "targetId": { "$ref": "#/$defs/opaqueId" }, "slot": { "type": "integer", "minimum": 0, "maximum": 36 }, "x": { "$ref": "#/$defs/tile" }, "y": { "$ref": "#/$defs/tile" }, "hayStack": { "type": "integer", "minimum": 1, "maximum": 999 } } },
    "foodTarget": { "type": "object", "additionalProperties": false, "required": ["slot", "qualifiedItemId", "stack", "edibility", "isDrink"], "properties": { "slot": { "type": "integer", "minimum": 0, "maximum": 36 }, "qualifiedItemId": { "type": "string", "minLength": 1, "maxLength": 128 }, "stack": { "type": "integer", "minimum": 1, "maximum": 999 }, "edibility": { "type": "integer", "minimum": -299, "maximum": 1000 }, "isDrink": { "type": "boolean" } } },
    "snapshot": { "type": "object", "additionalProperties": false, "required": ["revision", "location", "tile", "stamina", "health", "actionable", "capabilities"], "properties": { "revision": { "type": "integer" }, "location": { "type": "string" }, "tile": { "type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": { "x": { "type": "number" }, "y": { "type": "number" } } }, "stamina": { "type": "number" }, "health": { "type": "number" }, "currentTool": { "type": ["string", "null"] }, "inventorySlots": { "type": "integer", "minimum": 0, "maximum": 36 }, "actionable": { "type": "boolean" }, "capabilities": { "type": "array", "items": { "type": "string", "maxLength": 128 }, "maxItems": 128 }, "activeExecution": { "anyOf": [{ "$ref": "#/$defs/activeExecution" }, { "type": "null" }] }, "warps": { "type": "array", "items": { "$ref": "#/$defs/warp" }, "maxItems": 512 }, "doorTargets": { "type": "array", "items": { "$ref": "#/$defs/warp" }, "maxItems": 64 }, "soilTiles": { "type": "array", "items": { "$ref": "#/$defs/soilTile" }, "maxItems": 64 }, "toolSlots": { "type": "array", "items": { "$ref": "#/$defs/toolSlot" }, "maxItems": 36 }, "forageTargets": { "type": "array", "items": { "$ref": "#/$defs/forageTarget" }, "maxItems": 64 }, "itemTargets": { "type": "array", "items": { "$ref": "#/$defs/itemTarget" }, "maxItems": 64 }, "cropTargets": { "type": "array", "items": { "$ref": "#/$defs/cropTarget" }, "maxItems": 64 }, "harvestTargets": { "type": "array", "items": { "$ref": "#/$defs/harvestTarget" }, "maxItems": 64 }, "seedTargets": { "type": "array", "items": { "$ref": "#/$defs/seedTarget" }, "maxItems": 64 }, "fertilizerTargets": { "type": "array", "items": { "$ref": "#/$defs/fertilizerTarget" }, "maxItems": 64 }, "debrisTargets": { "type": "array", "items": { "$ref": "#/$defs/debrisTarget" }, "maxItems": 64 }, "machineTargets": { "type": "array", "items": { "$ref": "#/$defs/machineTarget" }, "maxItems": 64 }, "resourceTargets": { "type": "array", "items": { "$ref": "#/$defs/resourceTarget" }, "maxItems": 64 }, "npcRelationshipTargets": { "type": "array", "items": { "$ref": "#/$defs/npcRelationshipTarget" }, "maxItems": 64 }, "petTargets": { "type": "array", "items": { "$ref": "#/$defs/petTarget" }, "maxItems": 16 }, "animalProductTargets": { "type": "array", "items": { "$ref": "#/$defs/animalProductTarget" }, "maxItems": 32 }, "feedTroughTargets": { "type": "array", "items": { "$ref": "#/$defs/feedTroughTarget" }, "maxItems": 32 }, "foodTargets": { "type": "array", "items": { "$ref": "#/$defs/foodTarget" }, "maxItems": 36 } } },
    "executionRequest": { "type": "object", "additionalProperties": false, "required": ["requestId", "idempotencyKey", "action", "args", "expectedRevision", "deadlineMs"], "properties": { "requestId": { "$ref": "#/$defs/opaqueId" }, "idempotencyKey": { "$ref": "#/$defs/opaqueId" }, "action": { "enum": ["move_to_tile", "equip_tool", "travel", "enter_exit", "till_soil", "pickup_forage", "pickup_item", "water_crop", "harvest_crop", "plant_seed", "fertilize_tile", "clear_debris", "machine_inspect", "collect_resource", "npc_relationship", "pet_animal", "collect_animal_product", "feed_animal", "use_item", "inspect_self"] }, "args": { "type": "object" }, "expectedRevision": { "type": "integer" }, "deadlineMs": { "type": "integer" } } },
    "cancelRequest": { "type": "object", "additionalProperties": false, "required": ["requestId", "executionId", "reasonCode"], "properties": { "requestId": { "$ref": "#/$defs/opaqueId" }, "executionId": { "$ref": "#/$defs/opaqueId" }, "reasonCode": { "$ref": "#/$defs/reasonCode" } } },
    "executionState": { "enum": ["accepted", "running", "meaningful_progress", "blocked", "invalidated", "succeeded", "partially_succeeded", "failed", "cancelled", "expired", "rejected", "uncertain"] },
    "receipt": { "type": "object", "additionalProperties": false, "required": ["executionId", "requestId", "state", "reasonCode", "revision", "evidence"], "properties": { "executionId": { "$ref": "#/$defs/opaqueId" }, "requestId": { "$ref": "#/$defs/opaqueId" }, "state": { "$ref": "#/$defs/executionState" }, "reasonCode": { "$ref": "#/$defs/reasonCode" }, "revision": { "type": "integer" }, "evidence": { "type": ["object", "null"] } } },
    "error": { "type": "object", "additionalProperties": false, "required": ["reasonCode"], "properties": { "reasonCode": { "$ref": "#/$defs/reasonCode" } } },
    "semanticEvent": { "type": "object", "additionalProperties": false, "required": ["kind", "revision", "activeExecution", "reasonCode"], "properties": { "kind": { "enum": ["snapshot_changed", "execution_state", "connection_state", "lifecycle"] }, "revision": { "type": "integer" }, "activeExecution": { "anyOf": [{ "$ref": "#/$defs/activeExecution" }, { "type": "null" }] }, "reasonCode": { "$ref": "#/$defs/reasonCode" } } },
    "lifecycle": { "type": "object", "additionalProperties": false, "required": ["state", "reasonCode"], "properties": { "state": { "enum": ["connected", "disconnected", "world_unavailable"] }, "reasonCode": { "$ref": "#/$defs/reasonCode" } } }
  }
}
