{
  "schema": "stardew-action-smoke-contract/v1",
  "action": "clear_fish_pond",
  "discovery": {
    "cardinality": "at_least_one",
    "select": "first",
    "requiredFields": ["targetId", "x", "y", "occupants"]
  },
  "args": {
    "x": "$target.x",
    "y": "$target.y",
    "expectedTargetId": "$target.targetId"
  },
  "evidence": {
    "occupants_after": "0",
    "fish_type_after": "none",
    "occupants_before": { "equalsTarget": "occupants" },
    "fish_ejected": { "equalsTarget": "occupants" }
  },
  "worldAfter": [
    { "field": "fishPondTargets", "excludesTarget": true }
  ],
  "stale": {
    "refusedWith": ["pond_already_empty"]
  },
  "unasserted": {
    "worldAfter.itemTargets": "the runner counts ground debris (worldAfter.itemTargets) carrying the pond's fish type and requires that count to be at least the pond's occupants; a worldAfter form asserts a size or a target's absence, never one field ordered against another"
  }
}
