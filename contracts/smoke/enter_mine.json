{
  "schema": "stardew-action-smoke-contract/v1",
  "action": "enter_mine",
  "discovery": {
    "source": "mineEntranceTargets",
    "cardinality": "at_least_one",
    "select": "first",
    "requiredFields": [
      "targetId",
      "x",
      "y"
    ]
  },
  "args": {
    "x": "$target.x",
    "y": "$target.y",
    "expectedTargetId": "$target.targetId"
  },
  "delta": [
    {
      "to": "level",
      "atLeast": 1
    }
  ]
}
