{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist-test",
    "noEmit": false,
    "noEmitOnError": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "include": [
    "src/**/*.ts",
    "src/test-fixtures/windows-named-mutex-safety-seal-worker.ts",
    "src/test-fixtures/semantic-known-game-process-worker.ts",
    "src/test-fixtures/semantic-initial-chat-process-worker.ts"
  ],
  "exclude": ["src/main.ts"]
}
