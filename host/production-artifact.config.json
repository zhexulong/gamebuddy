      },
      {
        "package": "@cortexkit/pi-magic-context",
        "module": "runtime-core.internal.js",
        "expression": "\"@cortexkit/pi-magic-context/tavern\"",
        "occurrence": 2
      },
      {
        "package": "@cortexkit/pi-magic-context",
        "module": "runtime-core.internal.js",
        "expression": "\"@cortexkit/pi-magic-context/tavern\"",
        "occurrence": 3
      },
      {
        "package": "@cortexkit/pi-magic-context",
        "module": "tavern/memory-management/memory-management.js",
        "expression": "\"@cortexkit/pi-magic-context/memory\"",
