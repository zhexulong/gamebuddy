{
  "name": "@gamebuddy/companion-host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "build": "node scripts/build-production-artifact.mjs",
    "build:test": "node scripts/build-test-artifact.mjs",
    "start": "node scripts/start-production-artifact.mjs main.js",
    "start:dialogue": "node scripts/start-production-artifact.mjs dialogue-web-main.js",
    "start:farmhand-preview": "node scripts/start-production-artifact.mjs farmhand-companion-preview.js",
    "test": "node scripts/run-test-suite.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.test.json --noEmit",
    "check:production-artifact": "node scripts/check-production-artifact.mjs",
    "repair:test-artifact-lock": "node scripts/repair-test-artifact-lock.mjs"
  },
  "dependencies": {
    "@gamebuddy/voice-protocol": "workspace:*",
    "@cortexkit/pi-magic-context": "file:../vendor/magic-context/packages/pi-plugin",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "typebox": "1.1.38"
  },
  "devDependencies": {
    "@gamebuddy/game-action-devkit": "workspace:*",
    "@types/node": "24.10.1",
    "ajv": "8.17.1",
    "typescript": "5.9.3"
  }
}
