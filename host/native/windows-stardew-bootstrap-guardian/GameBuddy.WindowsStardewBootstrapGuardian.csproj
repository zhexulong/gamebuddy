<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>GameBuddy.WindowsStardewBootstrapGuardian</AssemblyName>
    <RootNamespace>GameBuddy.WindowsStardewBootstrapGuardian</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GuardianTestHooks)' == 'true'">
    <AssemblyName>GameBuddy.WindowsStardewBootstrapGuardian.Test</AssemblyName>
    <DefineConstants>$(DefineConstants);GUARDIAN_TEST_HOOKS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="fixtures/**/*.cs" />
  </ItemGroup>
</Project>
